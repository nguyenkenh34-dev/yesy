FPS.ZIndex = 100

local fpsDrag = false
local fpsStart
local fpsPos

FPS.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		fpsDrag = true
		fpsStart = input.Position
		fpsPos = FPS.Position
	end
end)

FPS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		fpsDrag = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if not fpsDrag then return end

	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then

		local d = input.Position - fpsStart

		FPS.Position = UDim2.new(
			fpsPos.X.Scale,
			fpsPos.X.Offset + d.X,
			fpsPos.Y.Scale,
			fpsPos.Y.Offset + d.Y
		)
	end
end)

