--==================================================
-- FPS COUNTER
--==================================================

local frames = 0
local last = os.clock()

RunService.RenderStepped:Connect(function()
	frames += 1

	local now = os.clock()

	if now - last >= 1 then
		local ping = 0

		pcall(function()
			ping = math.floor(Player:GetNetworkPing() * 1000 + 0.5)
		end)

		FPS.Text = frames .. " FPS - " .. ping .. " MS"

		frames = 0
		last = now
	end
end)

--==================================================
-- BOOST
--==================================================

local Enabled = false

local function Optimize(obj)
	pcall(function()

		if obj:IsA("ParticleEmitter") then
			obj.Rate = math.max(obj.Rate * 0.2,1)

			obj.Lifetime = NumberRange.new(
				math.max(obj.Lifetime.Min * 0.35,0.03),
				math.max(obj.Lifetime.Max * 0.35,0.05)
			)

		elseif obj:IsA("Trail") then
			obj.Lifetime = math.max(obj.Lifetime * 0.2,0.03)

		elseif obj:IsA("Beam") then
			obj.Width0 = obj.Width0 * 0.2
			obj.Width1 = obj.Width1 * 0.2

		elseif obj:IsA("BasePart") then
			obj.CastShadow = false

		elseif obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight") then
			obj.Brightness = obj.Brightness * 0.2
			obj.Range = obj.Range * 0.35

		elseif obj:IsA("Fire")
		or obj:IsA("Smoke")
		or obj:IsA("Sparkles") then
			obj.Enabled = false

		elseif obj:IsA("Clouds") then
			obj.Enabled = false
		end

	end)
end

local function RemoveFog()
	pcall(function()
		Lighting.FogStart = 0
		Lighting.FogEnd = 1000000
		Lighting.GlobalShadows = false
	end)

	for _,obj in ipairs(Lighting:GetChildren()) do
		pcall(function()

			if obj:IsA("Atmosphere") then
				obj.Density = 0
				obj.Haze = 0
				obj.Glare = 0

			elseif obj:IsA("BloomEffect")
			or obj:IsA("BlurEffect")
			or obj:IsA("SunRaysEffect")
			or obj:IsA("DepthOfFieldEffect") then
				obj.Enabled = false

			elseif obj:IsA("ColorCorrectionEffect") then
				obj.Saturation = 0
				obj.Contrast = 0
			end

		end)
	end
end

local function EnableBoost()

	RemoveFog()

	for _,obj in ipairs(Workspace:GetDescendants()) do
		Optimize(obj)
	end

	pcall(function()
		local Terrain = Workspace:FindFirstChildOfClass("Terrain")

		if Terrain then
			Terrain.WaterWaveSize = 0
			Terrain.WaterWaveSpeed = 0
			Terrain.WaterReflectance = 0
			Terrain.WaterTransparency = 1
		end
	end)
end

Workspace.DescendantAdded:Connect(function(obj)
	if Enabled then
		task.defer(function()
			Optimize(obj)
		end)
	end
end)

Lighting.ChildAdded:Connect(function()
	if Enabled then
		task.defer(RemoveFog)
	end
end)

Boost.MouseButton1Click:Connect(function()

	Enabled = not Enabled

	if Enabled then
		EnableBoost()

		Status.Text = "Boost: ON"
		Status.TextColor3 = Color3.fromRGB(0,255,100)

		Boost.Text = "BOOST ENABLED"
		Boost.BackgroundColor3 = Color3.fromRGB(0,150,90)

	else
		Status.Text = "Boost: OFF"
		Status.TextColor3 = Color3.fromRGB(255,80,80)

		Boost.Text = "ENABLE BOOST"
		Boost.BackgroundColor3 = Color3.fromRGB(0,120,255)
	end

end)

