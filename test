-- BUTTON
--==================================================

BoostButton.MouseButton1Click:Connect(function()

	BoostEnabled = not BoostEnabled

	if BoostEnabled then

		EnableBoost()

		Status.Text = "Boost: ON"
		Status.TextColor3 = Color3.fromRGB(0,255,100)

		BoostButton.Text = "BOOST ENABLED"
		BoostButton.BackgroundColor3 = Color3.fromRGB(0,150,90)

	else

		Status.Text = "Boost: OFF"
		Status.TextColor3 = Color3.fromRGB(255,80,80)

		BoostButton.Text = "ENABLE BOOST"
		BoostButton.BackgroundColor3 = Color3.fromRGB(0,120,255)

	end

end)

