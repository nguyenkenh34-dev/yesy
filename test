--==================================================
-- FPS COUNTER
--==================================================

local Frames = 0
local LastFPSUpdate = os.clock()

RunService.RenderStepped:Connect(function()

	Frames += 1

	local now = os.clock()

	if now - LastFPSUpdate >= 1 then

		local ping = 0

		pcall(function()
			ping = math.floor(Player:GetNetworkPing() * 1000 + 0.5)
		end)

		FPSText.Text = Frames .. " FPS - " .. ping .. " MS"

		Frames = 0
		LastFPSUpdate = now

	end

end)

--==================================================
-- BOOST
--==================================================

local BoostEnabled = false

local ChangedObjects = {}
local ChangedEffects = {}

local function DisableHeavyLighting()

	pcall(function()

		for _,effect in ipairs(Lighting:GetChildren()) do

			if effect:IsA("BloomEffect")
			or effect:IsA("BlurEffect")
			or effect:IsA("SunRaysEffect")
			or effect:IsA("DepthOfFieldEffect") then

				if ChangedEffects[effect] == nil then
					ChangedEffects[effect] = effect.Enabled
				end

				effect.Enabled = false

			end

		end

	end)

end

local function OptimizeObject(obj)

	pcall(function()

		-- Particle: giảm khoảng 60%
		if obj:IsA("ParticleEmitter") then

			if ChangedObjects[obj] == nil then
				ChangedObjects[obj] = {
					Rate = obj.Rate,
					Enabled = obj.Enabled
				}
			end

			obj.Rate = math.max(obj.Rate * 0.4, 1)

		-- Skill beam
		elseif obj:IsA("Beam") then

			if ChangedObjects[obj] == nil then
				ChangedObjects[obj] = {
					Enabled = obj.Enabled
				}
			end

			obj.Enabled = false

		-- Trail / kill effect
		elseif obj:IsA("Trail") then

			if ChangedObjects[obj] == nil then
				ChangedObjects[obj] = {
					Enabled = obj.Enabled
				}
			end

			obj.Enabled = false

		-- Fire / Smoke / Sparkles
		elseif obj:IsA("Fire")
		or obj:IsA("Smoke")
		or obj:IsA("Sparkles") then

			if ChangedObjects[obj] == nil then
				ChangedObjects[obj] = {
					Enabled = obj.Enabled
				}
			end

			obj.Enabled = false

		-- Xóa bóng
		elseif obj:IsA("BasePart") then

			if ChangedObjects[obj] == nil then
				ChangedObjects[obj] = {
					CastShadow = obj.CastShadow
				}
			end

			obj.CastShadow = false

		-- Skill light
		elseif obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight") then

			if ChangedObjects[obj] == nil then
				ChangedObjects[obj] = {
					Enabled = obj.Enabled
				}
			end

			obj.Enabled = false

		end

	end)

end

local function EnableBoost()

	--==================================================
	-- FOG / VIEW DISTANCE
	--==================================================

	pcall(function()

		Lighting.FogStart = 0
		Lighting.FogEnd = 1000000
		Lighting.GlobalShadows = false

	end)

	--==================================================
	-- LIGHTING EFFECT
	--==================================================

	DisableHeavyLighting()

	--==================================================
	-- MAP / SKILL EFFECT
	--==================================================

	for _,obj in ipairs(Workspace:GetDescendants()) do
		OptimizeObject(obj)
	end

	--==================================================
	-- TERRAIN
	--==================================================

	pcall(function()

		local Terrain = Workspace:FindFirstChildOfClass("Terrain")

		if Terrain then

			Terrain.WaterWaveSize = 0
			Terrain.WaterWaveSpeed = 0
			Terrain.WaterReflectance = 0

		end

	end)

end

--==================================================
-- NEW EFFECTS AFTER BOOST
--==================================================

Workspace.DescendantAdded:Connect(function(obj)

	if BoostEnabled then
		task.defer(function()
			OptimizeObject(obj)
		end)
	end

end)

